#!/bin/bash

# Mirror the working tree into the Omarchy plugins folder, the way an install would see it: every
# tracked or new file except dev/ and test/, and nothing left over from files moved or deleted.
# Symlinks are rejected by `omarchy plugin validate` and not followed by the file watcher.
# Omahub is keepLoaded, so the shell keeps the old instance across hot reloads.
# Pass --restart to restart the shell after syncing, or --watch to keep syncing on every save.

set -euo pipefail

ID="io.github.elberacasa.omahub"
SRC="$(cd "$(dirname "$0")/.." && pwd)"
DEST="$HOME/.config/omarchy/plugins/$ID"

sync_plugin() {
  local stage
  stage=$(mktemp -d)
  git -C "$SRC" ls-files --cached --others --exclude-standard -z \
    | grep -zvE '^(dev|test)/' \
    | rsync -a --from0 --files-from=- --ignore-missing-args "$SRC/" "$stage/"
  mkdir -p "$DEST"
  rsync -a --delete "$stage/" "$DEST/"
  rm -rf "$stage"
}

sync_plugin

if [[ ${1:-} == "--restart" ]]; then
  omarchy restart shell
elif [[ ${1:-} == "--watch" ]]; then
  while inotifywait -qq -r -e close_write,create,delete,move --exclude '/\.git/' "$SRC"; do
    sync_plugin
  done
fi
