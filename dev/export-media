#!/bin/bash

# Cut segments of a take into an MP4 for social posts and a GIF for READMEs.
#
#   dev/export-media <video> <name> <start-end> [<start-end>...] [--crop W:H:X:Y] [--filter <ffmpeg filters>] [--gif-width <px>] [--gif-fps <n>] [--no-gif]
#
# Segments are joined with hard cuts in the order given, for example:
#   dev/export-media tmp/takes/hero.mp4 capture-hero 0.5-13.5 27.3-30
# --crop frames one window instead of the whole monitor, so small UI stays readable in a README.
# --filter runs on the take before it is cut, so `enable='gte(t,8.5)'` uses the take's own clock,
# for example to cover a home path an app prints on screen.
# Output lands in tmp/media/.

set -euo pipefail

usage="usage: dev/export-media <video> <name> <start-end> [<start-end>...] [--crop W:H:X:Y] [--filter <ffmpeg filters>] [--gif-width <px>] [--gif-fps <n>] [--no-gif]"
root="$(cd "$(dirname "$0")/.." && pwd)"

(( $# >= 3 )) || { echo "$usage" >&2; exit 1; }

video="$1"
name="$2"
shift 2

segments=()
gif_width=960
gif_fps=24
gif=1
crop=""
extra=""

while (( $# )); do
  case "$1" in
    --crop) crop="crop=$2,"; shift 2 ;;
    --filter) extra="$2,"; shift 2 ;;
    --gif-width) gif_width="$2"; shift 2 ;;
    --gif-fps) gif_fps="$2"; shift 2 ;;
    --no-gif) gif=0; shift ;;
    *-*) segments+=("$1"); shift ;;
    *) echo "$usage" >&2; exit 1 ;;
  esac
done

[[ -f $video ]] || { echo "dev/export-media: no such video: $video" >&2; exit 1; }
(( ${#segments[@]} )) || { echo "$usage" >&2; exit 1; }

dir="$root/tmp/media"
mkdir -p "$dir"

filter=""
labels=""
for i in "${!segments[@]}"; do
  from="${segments[$i]%-*}"
  to="${segments[$i]#*-}"
  filter+="[0:v]${extra}${crop}trim=$from:$to,setpts=PTS-STARTPTS[s$i];"
  labels+="[s$i]"
done
filter+="${labels}concat=n=${#segments[@]}:v=1[v]"

ffmpeg -y -loglevel error -i "$video" -filter_complex "$filter" -map "[v]" \
  -c:v libx264 -crf 16 -preset slow -pix_fmt yuv420p -movflags +faststart -an \
  "$dir/$name.mp4"

if (( gif )); then
  ffmpeg -y -loglevel error -i "$dir/$name.mp4" \
    -vf "fps=$gif_fps,scale=$gif_width:-1:flags=lanczos,split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=4:diff_mode=rectangle" \
    -loop 0 "$dir/$name.gif"
fi

ls -lh "$dir/$name".*

# Nothing leaves the machine before OCR has looked for personal data in every half second of it.
if ! "$root/dev/privacy-check" "$dir/$name.mp4"; then
  echo "dev/export-media: $name may show personal data. Do not publish it until it is fixed and checked again." >&2
  exit 1
fi
