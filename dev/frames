#!/bin/bash

# Tile frames from a video into one timestamped image, to review motion or pick stills.
#
#   dev/frames <video> <start> <end> [--fps <n>] [--crop W:H:X:Y] [--width <px>] [--cols <n>] [--out <png>]
#
# Timestamps are video time, so a frame labeled 00:00:04.250 is 4.25s into the take.
# Use --fps 60 on a short window to inspect every frame of a transition.

set -euo pipefail

usage="usage: dev/frames <video> <start> <end> [--fps <n>] [--crop W:H:X:Y] [--width <px>] [--cols <n>] [--out <png>]"

(( $# >= 3 )) || { echo "$usage" >&2; exit 1; }

video="$1"
start="$2"
end="$3"
shift 3

fps=10
crop=""
width=480
cols=6
out=""

while (( $# )); do
  case "$1" in
    --fps) fps="$2"; shift 2 ;;
    --crop) crop="crop=$2,"; shift 2 ;;
    --width) width="$2"; shift 2 ;;
    --cols) cols="$2"; shift 2 ;;
    --out) out="$2"; shift 2 ;;
    *) echo "$usage" >&2; exit 1 ;;
  esac
done

[[ -f $video ]] || { echo "dev/frames: no such video: $video" >&2; exit 1; }

count=$(awk -v s="$start" -v e="$end" -v f="$fps" 'BEGIN { n = int((e - s) * f + 0.999); print (n < 1 ? 1 : n) }')
(( cols > count )) && cols=$count
rows=$(( (count + cols - 1) / cols ))
out="${out:-${video%.*}-frames-$start-$end.png}"

ffmpeg -y -loglevel error -ss "$start" -to "$end" -i "$video" \
  -vf "fps=$fps,${crop}scale=$width:-1,drawtext=text='%{pts\:hms\:$start}':x=6:y=6:fontsize=14:fontcolor=white:box=1:boxcolor=black@0.6,tile=${cols}x${rows}" \
  -frames:v 1 "$out"

echo "$out"
