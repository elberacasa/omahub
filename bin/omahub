#!/bin/bash

# omahub: the command behind the Omahub hub. The hub, people in a terminal, and agents all
# change settings through it, so every path behaves the same.

set -euo pipefail

OMAHUB_PATH="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
export OMAHUB_PATH
source "$OMAHUB_PATH/lib/settings.sh"

usage() {
  cat <<'EOF'
Usage: omahub <command>

  settings [--json]           List every setting, or print the catalog as JSON
  get <setting>               Print a setting's current state as JSON
  set <setting> <value>       Change a setting
  options <setting>           Print a setting's choices as JSON
  reset <setting>             Undo everything a setting changed
  open [where]                Open the hub at a section, a setting, or the welcome, or open the overview
  agent [agent] [--pick]      Start a coding agent in your projects folder, or a folder you pick
  edit [--pick]               Open your projects folder, or a folder you pick, in your editor
  project new <name>          Create a project and start your agent there (--editor, --no-open)
  project list                List the projects in your projects folder, newest first, as JSON
  project open <name>         Open a project on a free desktop in your editor and agent (--desktop <n>, --editor, --agent, --no-focus)
  dock pins|pin|unpin <app>   List, add, or remove the apps kept in the dock
  dock order <app>...         Keep exactly these apps, in this order
  desktop names               List the names given to desktops, as JSON
  desktop name <n> [name]     Name a desktop, or clear its name with no name
  uninstall [--yes]           Reset every setting and remove Omahub's data, before removing the plugin
  version                     Print the Omahub version

Settings are named <section>/<name>, for example keyboard/mac-screenshot-keys.
EOF
}

list_settings() {
  if [[ ${1:-} == "--json" ]]; then
    omahub_catalog
  else
    omahub_catalog | jq -r '
      map(select(.hidden | not))
      | group_by(.section)[]
      | (.[0].section | ascii_upcase), (.[] | "  \(.id)  \(.summary)"), ""'
  fi
}

run_setting() {
  local verb="$1" id="${2:-}" path
  [[ -n $id ]] || omahub_fail "usage: omahub $verb <setting>"

  path=$(omahub_setting_path "$id")
  [[ -n $path ]] || omahub_fail "no setting named '$id'. Run 'omahub settings' to list them."

  shift 2
  exec "$path" "$verb" "$@"
}

# Print the folder to work in: the projects folder, or one picked in the desktop folder chooser,
# which can also create a new one. Prints nothing when the chooser is cancelled.
work_folder() {
  local pick="$1" folder
  folder=$(omahub_projects_folder)
  mkdir -p "$folder"
  if [[ $pick == "--pick" ]]; then
    omarchy-file-select --directory --title "$2" || true
  else
    printf '%s\n' "$folder"
  fi
}

start_agent() {
  local agent="" pick="" folder
  while (( $# )); do
    case "$1" in
      --pick) pick="--pick"; shift ;;
      -*) omahub_fail "usage: omahub agent [agent] [--pick]" ;;
      *) agent="$1"; shift ;;
    esac
  done

  source "$OMAHUB_PATH/lib/defaults.sh"
  if [[ -n $agent && $agent != "$(omahub_default_agent)" ]] && ! omahub_defaults_installed "$agent"; then
    omahub_fail "$agent is not installed. Run 'omahub options projects/default-agent' to see the agents you have"
  fi

  folder=$(work_folder "$pick" "Start an agent in")
  if [[ -z $folder ]]; then
    exit 0
  fi
  cd "$folder"

  # The default agent starts through Omarchy with its own launch flags. Any other installed agent
  # starts plainly, in the same agent window class.
  if [[ -z $agent || $agent == "$(omahub_default_agent)" ]]; then
    exec omarchy-agent --pick
  else
    exec omarchy-launch-tui --app-id=org.omarchy.agent "$agent"
  fi
}

new_project() {
  local usage="usage: omahub project new <name> [--editor|--no-open]" name="" open="agent" dir
  if [[ ${1:-} != "new" ]]; then
    omahub_fail "$usage"
  fi
  shift
  while (( $# )); do
    case "$1" in
      --editor) open="editor"; shift ;;
      --no-open) open="none"; shift ;;
      -*) omahub_fail "$usage" ;;
      *) name="$name${name:+ }$1"; shift ;;
    esac
  done

  source "$OMAHUB_PATH/lib/defaults.sh"
  dir=$(omahub_project_new "$name")
  printf '%s\n' "$dir"
  cd "$dir"

  if [[ $open == "agent" ]]; then
    exec omarchy-agent --pick
  elif [[ $open == "editor" ]]; then
    exec omarchy-launch-editor "$dir"
  fi
}

project_command() {
  case "${1:-}" in
    new)
      new_project "$@"
      ;;
    list)
      source "$OMAHUB_PATH/lib/defaults.sh"
      omahub_projects_list
      ;;
    open)
      shift
      open_project "$@"
      ;;
    *)
      omahub_fail "usage: omahub project new|list|open"
      ;;
  esac
}

# Go to a desktop, the first free one unless one is given, and open a project there. Hyprland keeps the
# windows on that desktop even when the editor or the agent takes a while to start.
open_project() {
  local usage="usage: omahub project open <name> [--desktop <number>] [--editor|--agent] [--no-focus]"
  local name="" desktop="" open="both" focus=true dir quoted lua="" q="'"
  while (( $# )); do
    case "$1" in
      --desktop)
        (( $# >= 2 )) || omahub_fail "$usage"
        desktop="$2"
        shift 2
        ;;
      --editor) open="editor"; shift ;;
      --agent) open="agent"; shift ;;
      --no-focus) focus=false; shift ;;
      -*) omahub_fail "$usage" ;;
      *)
        [[ -z $name ]] || omahub_fail "$usage"
        name="$1"
        shift
        ;;
    esac
  done

  source "$OMAHUB_PATH/lib/defaults.sh"
  if [[ ! $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    omahub_fail "$usage"
  fi
  dir="$(omahub_projects_folder)/$name"
  if [[ ! -d $dir ]]; then
    omahub_fail "$(omahub_home_label "$dir") does not exist. Create it with: omahub project new $name"
  fi
  if [[ -z $desktop ]]; then
    desktop=$(omahub_free_desktop)
  fi
  if [[ ! $desktop =~ ^[1-9][0-9]*$ ]]; then
    omahub_fail "'$desktop' is not a desktop number"
  fi
  if [[ $dir == *"]]"* || $dir == *$'\n'* ]]; then
    omahub_fail "Hyprland cannot start a command in $(omahub_home_label "$dir"), since its path has ]] or a line break"
  fi

  quoted="$q${dir//$q/$q\\$q$q}$q"
  # --no-focus leaves going there to the caller, such as the overview, which keeps the pointer in place.
  if [[ $focus == true ]]; then
    lua="hl.dispatch(hl.dsp.focus({ workspace = \"$desktop\" }))"$'\n'
  fi
  if [[ $open != "agent" ]]; then
    lua+="hl.exec_cmd([[omarchy-launch-editor $quoted]], { workspace = \"$desktop\" })"
  fi
  if [[ $open != "editor" ]]; then
    lua+=$'\n'"hl.exec_cmd([[cd $quoted && exec omarchy-agent --pick]], { workspace = \"$desktop\" })"
  fi
  hyprctl eval "$lua" >/dev/null
  jq -nc --arg path "$dir" --argjson desktop "$desktop" --arg open "$open" '{path: $path, desktop: $desktop, open: $open}'
}

desktop_command() {
  local usage="usage: omahub desktop names|name <number> [name]"
  source "$OMAHUB_PATH/lib/desktops.sh"
  case "${1:-}" in
    names) omahub_desktop_names ;;
    name) omahub_desktop_name "${2:-}" "${3:-}" ;;
    *) omahub_fail "$usage" ;;
  esac
}

dock_command() {
  local usage="usage: omahub dock pins|pin <app>|unpin <app>|order <app>..."
  source "$OMAHUB_PATH/lib/dock.sh"
  case "${1:-}" in
    pins)
      omahub_dock_pins
      ;;
    order)
      shift
      omahub_dock_order "$@"
      omahub_dock_pins
      ;;
    pin | unpin)
      if [[ -z ${2:-} ]]; then
        omahub_fail "$usage"
      fi
      "omahub_dock_$1" "$2"
      omahub_dock_pins
      ;;
    *)
      omahub_fail "$usage"
      ;;
  esac
}

open_editor() {
  local folder
  source "$OMAHUB_PATH/lib/defaults.sh"
  folder=$(work_folder "${1:-}" "Open in your editor")
  if [[ -z $folder ]]; then
    exit 0
  fi
  exec omarchy-launch-editor "$folder"
}

# Put back everything Omahub changed, then remove its own data, so removing the plugin afterwards
# leaves nothing behind. Omarchy runs no hook when a plugin is removed, so this comes first. A
# failed reset keeps the data, since resets restore from it, and the command can simply run again.
uninstall() {
  local yes="" id path failed=()
  case "${1:-}" in
    --yes | -y) yes=1 ;;
    "") ;;
    *) omahub_fail "usage: omahub uninstall [--yes]" ;;
  esac

  if [[ -z $yes ]]; then
    if [[ -t 0 && -t 1 ]]; then
      gum confirm "Reset every Omahub setting and remove Omahub's data?" || exit 1
    else
      omahub_fail "uninstall resets every Omahub setting. Run it in a terminal to confirm, or pass --yes"
    fi
  fi

  # Actions have nothing to undo. The command on your PATH goes last, so it works to the end.
  while IFS= read -r id; do
    path=$(omahub_setting_path "$id")
    if [[ -z $path ]]; then
      continue
    fi
    if "$path" reset >/dev/null 2>&1; then
      echo "Reset $id"
    else
      failed+=("$id")
    fi
  done < <(omahub_catalog | jq -r --arg root "$OMAHUB_PATH/settings/" \
    '[.[] | select(.kind != "action" and (.path | startswith($root)))] | sort_by(.id == "agents/command") | .[].id')

  if (( ${#failed[@]} > 0 )); then
    omahub_fail "could not reset ${failed[*]}. Omahub's data is kept, so you can run uninstall again"
  fi

  rm -rf "$OMAHUB_STATE_DIR"
  echo
  echo "Omahub is reset and its data is gone. Remove the plugin with:"
  echo "  omarchy plugin remove $OMAHUB_PLUGIN_ID"
}

# Hooks in Claude Code and Codex call `omahub signal` when an agent waits on you. It reads the hook's JSON
# from standard input and notes the wait beside the agent's session record, keyed by that record's path.
# It prints nothing and always succeeds, so it can never change what the agent does.
agent_signal() {
  local input transcript event key dir
  input=$(cat)
  transcript=$(jq -r '.transcript_path // empty' <<<"$input" 2>/dev/null) || return 0
  event=$(jq -r '.hook_event_name // empty' <<<"$input" 2>/dev/null) || return 0
  [[ -n $transcript && -n $event ]] || return 0
  key=$(printf '%s' "$transcript" | sha1sum | cut -c1-16)
  dir="$OMAHUB_STATE_DIR/signals"
  mkdir -p "$dir"
  jq -nc --arg event "$event" --argjson at "$EPOCHSECONDS" '{event: $event, at: $at}' >"$dir/$key.json.tmp" \
    && mv "$dir/$key.json.tmp" "$dir/$key.json"
}

case "${1:-help}" in
  signal)
    agent_signal >/dev/null 2>&1 || true
    exit 0
    ;;
  settings)
    shift
    list_settings "$@"
    ;;
  get | set | options | reset)
    run_setting "$@"
    ;;
  open)
    if [[ ${2:-} == "welcome" ]]; then
      payload='{"view":"welcome"}'
    elif [[ ${2:-} == "overview" ]]; then
      payload='{"overview":"open"}'
    elif [[ ${2:-} == */* ]]; then
      payload=$(jq -nc --arg id "$2" '{section: ($id | split("/")[0]), setting: $id}')
    else
      payload=$(jq -nc --arg section "${2:-}" '{section: $section}')
    fi
    omarchy-shell shell summon "$OMAHUB_PLUGIN_ID" "$payload" >/dev/null
    ;;
  agent)
    shift
    start_agent "$@"
    ;;
  edit)
    shift
    open_editor "$@"
    ;;
  project)
    shift
    project_command "$@"
    ;;
  dock)
    shift
    dock_command "$@"
    ;;
  desktop)
    shift
    desktop_command "$@"
    ;;
  uninstall)
    shift
    uninstall "$@"
    ;;
  version)
    jq -r .version "$OMAHUB_PATH/manifest.json"
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
