#!/bin/bash

# omahub: the command behind the Omahub hub. The hub, people in a terminal, and agents all
# change settings through it, so every path behaves the same.

set -euo pipefail

OMAHUB_PATH="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
export OMAHUB_PATH
source "$OMAHUB_PATH/lib/settings.sh"

usage() {
  cat <<'EOF'
Usage: omahub <command>

  settings [--json]           List every setting, or print the catalog as JSON
  get <setting>               Print a setting's current state as JSON
  set <setting> <value>       Change a setting
  options <setting>           Print a setting's choices as JSON
  reset <setting>             Undo everything a setting changed
  open [where]                Open the hub at a section, a setting, or the welcome
  agent [agent] [--pick]      Start a coding agent in your projects folder, or a folder you pick
  edit [--pick]               Open your projects folder, or a folder you pick, in your editor
  project new <name>          Create a project and start your agent there (--editor, --no-open)
  version                     Print the Omahub version

Settings are named <section>/<name>, for example keyboard/mac-screenshot-keys.
EOF
}

list_settings() {
  if [[ ${1:-} == "--json" ]]; then
    omahub_catalog
  else
    omahub_catalog | jq -r '
      map(select(.hidden | not))
      | group_by(.section)[]
      | (.[0].section | ascii_upcase), (.[] | "  \(.id)  \(.summary)"), ""'
  fi
}

run_setting() {
  local verb="$1" id="${2:-}" path
  [[ -n $id ]] || omahub_fail "usage: omahub $verb <setting>"

  path=$(omahub_setting_path "$id")
  [[ -n $path ]] || omahub_fail "no setting named '$id'. Run 'omahub settings' to list them."

  shift 2
  exec "$path" "$verb" "$@"
}

# Print the folder to work in: the projects folder, or one picked in the desktop folder chooser,
# which can also create a new one. Prints nothing when the chooser is cancelled.
work_folder() {
  local pick="$1" folder
  folder=$(omahub_projects_folder)
  mkdir -p "$folder"
  if [[ $pick == "--pick" ]]; then
    omarchy-file-select --directory --title "$2" || true
  else
    printf '%s\n' "$folder"
  fi
}

start_agent() {
  local agent="" pick="" folder
  while (( $# )); do
    case "$1" in
      --pick) pick="--pick"; shift ;;
      -*) omahub_fail "usage: omahub agent [agent] [--pick]" ;;
      *) agent="$1"; shift ;;
    esac
  done

  source "$OMAHUB_PATH/lib/defaults.sh"
  if [[ -n $agent && $agent != "$(omahub_default_agent)" ]] && ! omahub_defaults_installed "$agent"; then
    omahub_fail "$agent is not installed"
  fi

  folder=$(work_folder "$pick" "Start an agent in")
  if [[ -z $folder ]]; then
    exit 0
  fi
  cd "$folder"

  # The default agent starts through Omarchy with its own launch flags. Any other installed agent
  # starts plainly, in the same agent window class.
  if [[ -z $agent || $agent == "$(omahub_default_agent)" ]]; then
    exec omarchy-agent --pick
  else
    exec omarchy-launch-tui --app-id=org.omarchy.agent "$agent"
  fi
}

new_project() {
  local usage="usage: omahub project new <name> [--editor|--no-open]" name="" open="agent" dir
  if [[ ${1:-} != "new" ]]; then
    omahub_fail "$usage"
  fi
  shift
  while (( $# )); do
    case "$1" in
      --editor) open="editor"; shift ;;
      --no-open) open="none"; shift ;;
      -*) omahub_fail "$usage" ;;
      *) name="$name${name:+ }$1"; shift ;;
    esac
  done

  source "$OMAHUB_PATH/lib/defaults.sh"
  dir=$(omahub_project_new "$name")
  printf '%s\n' "$dir"
  cd "$dir"

  if [[ $open == "agent" ]]; then
    exec omarchy-agent --pick
  elif [[ $open == "editor" ]]; then
    exec omarchy-launch-editor "$dir"
  fi
}

open_editor() {
  local folder
  source "$OMAHUB_PATH/lib/defaults.sh"
  folder=$(work_folder "${1:-}" "Open in your editor")
  if [[ -z $folder ]]; then
    exit 0
  fi
  exec omarchy-launch-editor "$folder"
}

case "${1:-help}" in
  settings)
    shift
    list_settings "$@"
    ;;
  get | set | options | reset)
    run_setting "$@"
    ;;
  open)
    if [[ ${2:-} == "welcome" ]]; then
      payload='{"view":"welcome"}'
    elif [[ ${2:-} == */* ]]; then
      payload=$(jq -nc --arg id "$2" '{section: ($id | split("/")[0]), setting: $id}')
    else
      payload=$(jq -nc --arg section "${2:-}" '{section: $section}')
    fi
    omarchy-shell shell summon "$OMAHUB_PLUGIN_ID" "$payload" >/dev/null
    ;;
  agent)
    shift
    start_agent "$@"
    ;;
  edit)
    shift
    open_editor "$@"
    ;;
  project)
    shift
    new_project "$@"
    ;;
  version)
    jq -r .version "$OMAHUB_PATH/manifest.json"
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
