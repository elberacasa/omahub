# omahub:section=dock
# omahub:order=30
# omahub:kind=choice
# omahub:icon=󰍉
# omahub:keywords=dock magnify magnification zoom icons grow hover subtle large

set -euo pipefail
source "${OMAHUB_PATH:?run this through omahub}/lib/settings.sh"
source "$OMAHUB_PATH/lib/dock.sh"

# Before it became a choice, this was a switch: on means Large, off means Off.
args=("$@")
if [[ ${1:-} == "set" ]]; then
  case "${2:-}" in
    on | true) args=(set large) ;;
    false) args=(set off) ;;
  esac
fi

omahub_dock_choice_setting magnify large "off=Off subtle=Subtle large=Large" dock/magnify "${args[@]}"
