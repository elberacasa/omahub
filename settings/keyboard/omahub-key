#!/bin/bash

# omahub:title=Omahub key
# omahub:summary=SUPER + A opens Omahub
# omahub:section=keyboard
# omahub:kind=toggle
# omahub:icon=󰌌
# omahub:keywords=shortcut hotkey super open hub

set -euo pipefail
source "${OMAHUB_PATH:?run this through omahub}/lib/settings.sh"
source "$OMAHUB_PATH/lib/keymap.sh"

state() {
  if omahub_keymap_has hotkey; then
    omahub_state true "On"
  else
    omahub_state false "Off"
  fi
}

case "${1:-}" in
  get)
    state
    ;;
  set)
    case "${2:-}" in
      on | true) omahub_keymap_set hotkey on ;;
      off | false) omahub_keymap_set hotkey off ;;
      *) omahub_fail "usage: omahub set keyboard/omahub-key on|off" ;;
    esac
    state
    ;;
  reset)
    omahub_keymap_set hotkey off
    state
    ;;
  *)
    omahub_fail "usage: omahub get|set|reset keyboard/omahub-key"
    ;;
esac
